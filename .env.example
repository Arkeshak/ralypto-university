# Copy this file to .env (git-ignored) and fill in values locally.
# Never put real credentials in this file and never commit .env.
#
# With no provider set, ProcureAgents runs in a clearly labelled
# "deterministic (offline, no LLM)" mode: all numbers come from code,
# LLM text is skipped, and the single-agent baseline is reported as "not run".

# offline | anthropic | openai   (openai = any OpenAI-compatible server, including local Ollama)
LLM_PROVIDER=offline
LLM_MODEL=
LLM_API_KEY=
# Optional base URL, e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=
LLM_TEMPERATURE=0
LLM_TIMEOUT=60

# USD per million tokens, used only for cost logging in the benchmark
LLM_PRICE_IN=0
LLM_PRICE_OUT=0

# Example: Anthropic
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-5-5
# LLM_API_KEY=<your key>

# Example: local Ollama (free, runs on your machine)
# LLM_PROVIDER=openai
# LLM_MODEL=qwen2.5-coder:7b
# LLM_BASE_URL=http://localhost:11434/v1
